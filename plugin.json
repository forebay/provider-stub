{
  "api": 1,
  "importName": "provider-stub",
  "id": "provider-stub",
  "version": "3.0.0",
  "entry": "dist/plugin.js",
  "bundle": {
    "entry": "src/plugin.ts"
  },
  "displayName": "Stub",
  "capabilities": {
    "provides": ["forebay.provider"],
    "consumes": []
  },
  "services": {
    "provides": ["provider-stub:accounts"],
    "consumes": ["accounts", "anthropic", "weivel.config", "weivel.paths", "weivel.log"]
  },
  "actions": {
    "login": {
      "label": "Add a demo account",
      "call": {
        "service": "provider-stub:accounts",
        "method": "login"
      }
    },
    "accounts": {
      "label": "List demo accounts",
      "call": {
        "service": "provider-stub:accounts",
        "method": "list"
      }
    }
  },
  "config": {
    "defaults": {
      "account_selection_strategy": "hybrid",
      "logging": true,
      "response_text": "Hello from provider-stub: the provider pipeline works end to end.",
      "model_count": 3,
      "latency_ms": 0,
      "fail_rate": 0,
      "streaming": null
    }
  },
  "repo": {
    "role": "Example reference provider",
    "category": "ai-provider",
    "tech": ["typescript"]
  }
}
